# WhatsApp Cloud API — Environment Variables
# Set these in Netlify Dashboard → Site → Environment Variables
# DO NOT commit this file with real values.

# Your WhatsApp Business phone number ID (from Meta Developer Dashboard → WhatsApp → API Setup)
WHATSAPP_PHONE_NUMBER_ID=

# Permanent access token (Meta Developer Dashboard → WhatsApp → API Setup → Generate Token)
WHATSAPP_ACCESS_TOKEN=

# Your personal WhatsApp number to receive notifications
# Format: country code + number, no + or spaces (e.g. 919876543210)
WHATSAPP_RECIPIENT=
